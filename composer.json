{
    "name": "moonshine/twirl",
    "description": "Web sockets for MoonShine for component reload",
    "keywords": ["moonshine", "twirl", "web socket"],
    "type": "library",
    "homepage": "https://moonshine.cutcode.dev",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/moonshine-software/twirl/issues",
        "source": "https://github.com/moonshine-software/twirl"
    },
    "authors": [
        {
            "name": "Ivan Levchenko",
            "email": "lkivanmail@gmail.com",
            "homepage": "https://github.com/dev-lnk"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "orchestra/testbench": "^9.0",
        "rector/rector": "^1.0",
        "moonshine/moonshine": "3.x-dev"
    },
    "autoload": {
        "psr-4": {
            "MoonShine\\Twirl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MoonShine\\Twirl\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "moonshine/moonshine": "<3.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "MoonShine\\Twirl\\Providers\\TwirlServiceProvider"
            ]
        }
    }
}
